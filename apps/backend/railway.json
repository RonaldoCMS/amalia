{
  "$schema": "https://railway.app/railway-schema.json",
  "build": {
    "builder": "NIXPACKS",
    "buildCommand": "npm install && cd apps/backend && npm run build"
  },
  "deploy": {
    "startCommand": "node apps/backend/dist/apps/backend/src/main.js",
    "restartPolicyType": "ON_FAILURE"
  }
}